# Copiar a app/.env. Reiniciar Expo después de cambiar valores.
# La configuración pública de Firebase no sustituye las reglas de seguridad.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
EXPO_PUBLIC_API_BASE_URL=
# Solo backend; nunca EXPO_PUBLIC ni incluir en el repositorio.
AI_PROVIDER_API_KEY=
AI_MODEL=
AI_REGION=

