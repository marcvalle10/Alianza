{
  "expo": {
    "name": "Alianza Servicios",
    "slug": "alianza-servicios",
    "scheme": "alianza",
    "plugins": ["expo-router"],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/alianza-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.alianzainformatica.servicios",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/alianza-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/alianza-logo.png"
    }
  }
}
