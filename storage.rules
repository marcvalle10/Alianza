rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function verified() { return request.auth != null && request.auth.token.email_verified == true; }
    function membership(tenant) {
      return firestore.get(/databases/(default)/documents/tenants/$(tenant)/members/$(request.auth.uid));
    }
    function ticket(tenant, id) { return firestore.get(/databases/(default)/documents/tenants/$(tenant)/tickets/$(id)); }
    function active(tenant, member) {
      return member != null && member.data.active == true && member.data.tenantId == tenant;
    }
    function reader(tenant, id) {
      let p = membership(tenant);
      let t = ticket(tenant, id);
      return active(tenant, p) && t != null && t.data.tenantId == tenant && (p.data.role == 'admin'
        || (p.data.role == 'technician' && t.data.assignedTo == request.auth.uid)
        || (p.data.role == 'client' && t.data.createdBy == request.auth.uid));
    }
    function editor(tenant, id) {
      let p = membership(tenant);
      let t = ticket(tenant, id);
      return active(tenant, p) && t != null && t.data.tenantId == tenant && t.data.status != 'Concluido'
        && (p.data.role == 'admin' || (p.data.role == 'technician' && t.data.assignedTo == request.auth.uid));
    }
    match /tenants/{tenant}/tickets/{id}/{slot} {
      allow get: if verified() && slot in ['proposal', 'before', 'after'] && reader(tenant, id);
      allow create, update: if verified() && slot in ['proposal', 'before', 'after'] && editor(tenant, id)
        && request.resource.size > 0 && request.resource.size <= 6 * 1024 * 1024
        && (request.resource.contentType in ['image/jpeg','image/png']
          || (slot == 'proposal' && request.resource.contentType == 'application/pdf'));
      allow list, delete: if false;
    }
  }
}
